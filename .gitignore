# --- Build firmware (PlatformIO) ---
.pio/
.pio-core/
build/
dist/
*.bin
*.elf
*.map

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- Dati e output locali del generatore mappe ---
*.pbf
*.pbf.part
*.osm.mmap
*.mmap
.pbf_cache/
tiles/
tiles_*/
maps/
scratch/
log_serial.txt
monomesh_serial.log

# --- Toolchain e binari nativi ---
# I sorgenti nativi servono alla build e ai test in CI: si versionano.
# Binari, cache del compilatore e toolchain restano locali.
/tools/.toolchain/
/tools/native/*
!/tools/native/*.c
!/tools/native/*.h
!/tools/native/*.sh
!/tools/native/*.py
!/tools/native/README.md
!/tools/native/libmapcore/
!/tools/native/libmapcore/**
# Di zlib serve solo il codice compilato dalla build, non contrib/doc
!/tools/native/third_party/
!/tools/native/third_party/zlib/
/tools/native/third_party/zlib/*
!/tools/native/third_party/zlib/*.c
!/tools/native/third_party/zlib/*.h
!/tools/native/third_party/zlib/LICENSE
/tools/native/.zig-cache/
/tools/auto_flash_and_monitor.py
/tools/tests/test_native.py

# --- Riferimenti e materiale di terzi (solo in locale) ---
reference/
M5PaperMono-PowerDemo-main/
M5Burner*.zip

# --- Briefing di sessione / agenti / documentazione interna ---
.agents/
.codex/
HANDOFF_PROMPT.md
README_INTERNAL.md

# --- Editor e sistema operativo ---
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db

# --- Archivi e log vari ---
*.zip
*.7z
*.log
